# Copy this file to .env. Docker Compose reads it automatically.

# Admin page token. Set a strong value for production; leave empty to configure
# the password during the first visit to /admin/.
ADMIN_TOKEN=

# Host port exposed by Docker. The service always listens on port 8080 inside
# the container.
HOST_PORT=8080

# Image tag. Use a fixed release version in production, for example: 0.1.0.
MODEL_UPTIME_TAG=latest

# Shared only between the app and the internal update sidecar. Generate with:
# openssl rand -hex 32
UPDATE_TOKEN=
