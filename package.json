{
  "name": "model-uptime-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/web/*.test.js tests/deployment/*.test.js",
    "check:js": "npm run lint",
    "lint": "eslint \"internal/httpserver/web/assets/scripts/**/*.js\" \"tests/**/*.js\" eslint.config.js",
    "format": "prettier --write \"internal/httpserver/web/assets/scripts/**/*.js\" \"tests/**/*.js\" eslint.config.js package.json api/openapi.yaml .prettierrc.json",
    "format:check": "prettier --check \"internal/httpserver/web/assets/scripts/**/*.js\" \"tests/**/*.js\" eslint.config.js package.json api/openapi.yaml .prettierrc.json"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  }
}
